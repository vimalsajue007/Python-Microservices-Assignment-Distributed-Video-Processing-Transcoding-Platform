# Copy to .env — every value is optional; the defaults below work out of the box.
MYSQL_ROOT_PASSWORD=root_pw
UPLOAD_DB_PASSWORD=upload_pw
METADATA_DB_PASSWORD=metadata_pw
ORCHESTRATOR_DB_PASSWORD=orchestrator_pw
TRANSCODER_DB_PASSWORD=transcoder_pw
THUMBNAIL_DB_PASSWORD=thumbnail_pw
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# HMAC secret for signed media URLs — CHANGE IN PRODUCTION
MEDIA_SIGNING_SECRET=change-me-in-production
# Upload limit in bytes (default 500 MiB)
MAX_UPLOAD_BYTES=524288000
# Failure demo: make the first N transcoding attempts of every job fail (0 = off)
SIMULATE_FAILURE_ATTEMPTS=0
LOG_LEVEL=INFO
